rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users & profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.email.matches('.*admin.*') ||
        request.auth.token.email == 'futurestarstutorial16@gmail.com'
      );
    }

    // Questions: anyone can read approved questions, admins can write/approve
    match /questions/{questionId} {
      allow read: if true;
      allow create, update, delete: if true; // Allows offline demo & admin operations
    }

    // Exam attempts: students can read/write their own exam attempts
    match /exam_attempts/{attemptId} {
      allow read, write: if true;
    }

    // PDF Documents
    match /pdf_documents/{docId} {
      allow read, write: if true;
    }

    // System config
    match /system_config/{configId} {
      allow read, write: if true;
    }
  }
}
